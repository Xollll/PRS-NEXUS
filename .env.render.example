# Copy these values into Render's Environment page. Do not commit a real .env.
APP_NAME="PRS NEXUS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Render PostgreSQL connection details. Enter the Internal connection values
# from the Render database's Connect panel.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Local profile photos are ephemeral on Render. Attach a persistent disk or
# configure object storage before allowing production avatar uploads.
FILESYSTEM_DISK=public
