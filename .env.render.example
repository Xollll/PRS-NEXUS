# Copy these values into Render's Environment page. Do not commit a real .env.
APP_NAME="PRS NEXUS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Render MySQL private service connection details.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=prs_nexus
DB_USERNAME=prs_nexus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Local profile photos are ephemeral on Render. Attach a persistent disk or
# configure object storage before allowing production avatar uploads.
FILESYSTEM_DISK=public
